+  /**
+    * Send a batch proof for box lookups to a peer asked for it, together with the id of the block
+    * whose state root the proof is against. If a block is applied while the proof is generated,
+    * nothing is sent (the peer can ask again), so the answer never names the wrong block.
+    */
+  private def sendBoxProof(ids: Seq[Array[Byte]], usr: UtxoStateReader, peer: ConnectedPeer): Unit = {
+    val versionBefore = usr.version
+    val proof = usr.generateBatchProofForBoxes(ids.map(id => scorex.crypto.authds.ADKey @@ id))
+    if (usr.version == versionBefore) {
+      val data = BoxProofData(org.ergoplatform.core.versionToBytes(versionBefore), proof)
+      networkControllerRef ! SendToNetwork(Message(BoxProofSpec, Right(data), None), SendToPeer(peer))
+    } else {
+      log.info(s"State changed while generating a box proof for $peer, not sending")
+    }
+  }
+
   /**
     * Process NiPoPoW proof got from remote peer
     */
@@ -1703,6 +1719,11 @@ class ErgoNodeViewSynchronizer(networkControllerRef: ActorRef,
       }
     case (_: GetNipopowProofSpec.type, data: NipopowProofData, remote) =>
       sendNipopowProof(data, hr, remote)
+    case (_: GetBoxProofSpec.type, ids: Seq[_], remote) =>
+      usrOpt match {
+        case Some(usr) => sendBoxProof(ids.collect { case id: Array[Byte] => id }, usr, remote)
+        case None => log.warn(s"Asked for a box proof when UTXO set is not supported, remote: $remote")
+      }
