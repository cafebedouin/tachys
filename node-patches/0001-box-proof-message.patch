+package org.ergoplatform.network.message
+
+import org.ergoplatform.network.message.MessageConstants.MessageCode
+import scorex.util.serialization.{Reader, Writer}
+
+/**
+  * Request for a batch proof that boxes exist (or do not exist) in the current UTXO set.
+  * Payload: number of ids, then the 32-byte box ids.
+  */
+object GetBoxProofSpec extends MessageSpecV1[Seq[Array[Byte]]] {
+
+  val MaxIds = 100
+  val IdLength = 32
+  val SizeLimit: Int = 2 + MaxIds * IdLength + 2 + 100
+
+  val messageCode: MessageCode = 92: Byte
+  val messageName: String = "GetBoxProof"
+
+  override def serialize(ids: Seq[Array[Byte]], w: Writer): Unit = {
+    w.putUShort(ids.length)
+    ids.foreach(id => w.putBytes(id))
+    w.putUShort(0) // pad length, for future extension
+  }
+
+  override def parse(r: Reader): Seq[Array[Byte]] = {
+    require(r.remaining <= SizeLimit, s"Too big GetBoxProof message (size: ${r.remaining})")
+    val count = r.getUShort()
+    require(count > 0 && count <= MaxIds, s"GetBoxProof asks for $count boxes, allowed 1..$MaxIds")
+    val ids = (0 until count).map(_ => r.getBytes(IdLength))
+    val pad = r.getUShort()
+    if (pad > 0 && pad < SizeLimit) r.getBytes(pad)
+    ids
+  }
+}
+
+/**
+  * @param headerId - id of the block whose state root the proof is against
+  * @param proof    - serialized batch AVL+ proof for lookups of the requested ids, in request order
+  */
+case class BoxProofData(headerId: Array[Byte], proof: Array[Byte])
+
+/**
+  * Answer to GetBoxProof: the header the proof is against, then the proof.
+  */
+object BoxProofSpec extends MessageSpecV1[BoxProofData] {
+
+  val SizeLimit = 2000000
+
+  val messageCode: MessageCode = 93: Byte
+  val messageName: String = "BoxProof"
+
+  override def serialize(data: BoxProofData, w: Writer): Unit = {
+    w.putBytes(data.headerId)
+    w.putUInt(data.proof.length.toLong)
+    w.putBytes(data.proof)
+    w.putUShort(0) // pad length, for future extension
+  }
+
+  override def parse(r: Reader): BoxProofData = {
+    require(r.remaining <= SizeLimit, s"Too big BoxProof message (size: ${r.remaining})")
+    val headerId = r.getBytes(32)
+    val len = r.getUInt().toInt
+    require(len >= 0 && len <= SizeLimit, s"BoxProof declares $len proof bytes")
+    val proof = r.getBytes(len)
+    val pad = r.getUShort()
+    if (pad > 0 && pad < SizeLimit) r.getBytes(pad)
+    BoxProofData(headerId, proof)
+  }
+}
